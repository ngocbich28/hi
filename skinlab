  } else {
    $("profileStatus").textContent =
      "Chưa có sản phẩm phù hợp tất cả tiêu chí. Hãy thử điều chỉnh lựa chọn.";
  }
}

$("profileForm").addEventListener("submit", event => {
  event.preventDefault();

  if (!$("consent").checked) {
    $("profileStatus").textContent =
      "Vui lòng xác nhận đồng ý sử dụng lựa chọn trong bản demo.";
    return;
  }

  const profile = getProfile();

  if (!profile.benefits.length) {
    $("profileStatus").textContent =
      "Vui lòng chọn ít nhất một công dụng mong muốn.";
    return;
  }

  if (!profile.kinds.length) {
    $("profileStatus").textContent =
      "Vui lòng chọn ít nhất một loại sản phẩm.";
    return;
  }

  updateDynamicContent(profile);

  // Không lưu hồ sơ cá nhân hoặc nội dung trường dị ứng.
  // Chỉ cập nhật kết quả trên trang hiện tại.
  $("recommendation").scrollIntoView({
    behavior: "smooth",
    block: "start"
  });
});

/* =========================================
   8. RESET FORM
========================================= */

$("resetProfile").addEventListener("click", () => {
  $("profileForm").reset();

  $("resultTitle").textContent = "Your skin, your story.";
  $("resultDescription").textContent =
    "Hoàn thành hồ sơ để xem nội dung và sản phẩm được cá nhân hóa.";

  $("bannerTitle").textContent = "Small steps. Thoughtful care.";
  $("bannerDescription").textContent =
    "Những gợi ý sẽ thay đổi theo nhu cầu bạn cung cấp.";

  $("profileTags").innerHTML = "";
  $("personalProducts").innerHTML = `
    <div class="placeholder">
      🌸<br>Gợi ý dành riêng cho bạn sẽ xuất hiện ở đây.
    </div>
  `;

  $("profileStatus").textContent = "Đã xóa lựa chọn trên biểu mẫu.";
});

</script>
