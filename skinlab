  return {
    age: $("age").value,
    skin: $("skin").value,
    benefits: [...document.querySelectorAll(
      'input[name="benefit"]:checked'
    )].map(input => input.value),
    kinds: [...document.querySelectorAll(
      'input[name="kind"]:checked'
    )].map(input => input.value),
    budget: $("budget").value,
    allergies: $("allergies").value.trim()
  };
}

function getProfileMatches(profile) {
  const avoidTags = parseAvoidIngredients(profile.allergies);
  const [min, max] = budgetRanges[profile.budget];

  const criteria = {
    skin: profile.skin,
    benefits: profile.benefits,
    kind: null,
    budget: profile.budget
  };

  let matches = products.filter(product => {
    if (!product.skins.includes(profile.skin)) return false;
    if (product.price < min || product.price >= max) return false;

    if (profile.kinds.length &&
        !profile.kinds.includes(product.kind)) {
      return false;
    }

    if (product.ingredients.some(tag => avoidTags.includes(tag))) {
      return false;
    }

    return true;
  });

  // Nếu không có kết quả, không tự ý bỏ qua ngân sách,
  // loại da, loại sản phẩm hoặc điều kiện tránh thành phần.
  return matches.map(product => ({
    product,
    score: scoreProduct(product, criteria, avoidTags)
  }))
  .sort((a, b) => b.score - a.score);
}

