function normalize(text) {
  return String(text)
    .toLocaleLowerCase("vi")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/đ/g, "d")
    .trim();
}

function escapeHTML(text) {
  return String(text).replace(/[&<>"']/g, char => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  })[char]);
}

/* =========================================
   2. SEARCH QUERY ANALYSIS
========================================= */

function analyzeQuery(query) {
  const q = normalize(query);
  const criteria = {
    skin: null,
    benefits: [],
    kind: null,
    budget: null
  };

  if (/\b(da dau|dau nhieu|bong dau|oily skin)\b/.test(q)) {
    criteria.skin = "oily";
  } else if (/\b(da kho|kho da|dry skin)\b/.test(q)) {
    criteria.skin = "dry";
  } else if (/\b(da hon hop|hon hop)\b/.test(q)) {
    criteria.skin = "combination";
  } else if (/\b(da nhay cam|nhay cam|sensitive skin)\b/.test(q)) {
    criteria.skin = "sensitive";
  } else if (/\b(da thuong|normal skin)\b/.test(q)) {
    criteria.skin = "normal";
  }

  // Từ khóa "da mụn" là nhu cầu chăm sóc da mụn,
  // không phải chẩn đoán tình trạng da.
  if (/\b(da mun|mun|acne|breakout)\b/.test(q)) {
    criteria.benefits.push("acne");
  }

  if (/\b(kiem soat dau|giam dau|oil control|bong nhon)\b/.test(q)) {
    criteria.benefits.push("oil");
  }

  if (/\b(cap am|duong am|hydration|moisturizing)\b/.test(q)) {
    criteria.benefits.push("hydration");
  }

  if (/\b(lam sach|sach da|cleanser|face wash)\b/.test(q)) {
    criteria.benefits.push("clean");
  }

  if (/\b(lam diu|diu da|soothing|calming)\b/.test(q)) {
    criteria.benefits.push("soothe");
  }

  if (/\b(lam sang|sang da|rang ro|glow|brightening)\b/.test(q)) {
    criteria.benefits.push("glow");
  }

  if (criteria.skin === "oily" && !criteria.benefits.includes("oil")) {
    criteria.benefits.push("oil");
  }

  if (/\b(sua rua mat|srm|cleanser|face wash)\b/.test(q)) {
    criteria.kind = "cleanser";
  } else if (/\b(serum|tinh chat)\b/.test(q)) {
    criteria.kind = "serum";
  } else if (/\b(toner|nuoc hoa hong)\b/.test(q)) {
    criteria.kind = "toner";
  } else if (/\b(mat na|mask)\b/.test(q)) {
    criteria.kind = "mask";
  } else if (/\b(essence)\b/.test(q)) {
    criteria.kind = "essence";
  }

  if (/\b(duoi 150|under 150)\b/.test(q)) {
    criteria.budget = "under150";
  } else if (/\b(150 den 300|150-300)\b/.test(q)) {
    criteria.budget = "150-300";
  } else if (/\b(300 den 500|300-500)\b/.test(q)) {
    criteria.budget = "300-500";
  } else if (/\b(tren 500|over 500)\b/.test(q)) {
    criteria.budget = "over500";
  }

  return criteria;
}

/* =========================================
   3. ALLERGY / INGREDIENT EXCLUSION
   This is only a simple demo keyword matcher.
========================================= */

function parseAvoidIngredients(raw) {
  const q = normalize(raw);
  const tags = [];

  if (/\b(fragrance|perfume|huong lieu|nuoc hoa)\b/.test(q)) {
    tags.push("fragrance");
  }

  if (/\b(essential oil|tinh dau)\b/.test(q)) {
    tags.push("essential-oil");
  }

  return tags;
}

/* =========================================
   4. PRODUCT MATCHING ENGINE
========================================= */

function scoreProduct(product, criteria, avoidTags = []) {
  // Không gợi ý sản phẩm có tag trùng thành phần cần tránh.
  if (product.ingredients.some(tag => avoidTags.includes(tag))) {
    return -1;
  }

  let score = 0;

  if (criteria.kind) {
    if (product.kind !== criteria.kind) return -1;
    score += 5;
  }

  if (criteria.skin) {
    if (!product.skins.includes(criteria.skin)) return -1;
    score += 4;
  }

  if (criteria.benefits.length) {
    const matches = criteria.benefits.filter(
      benefit => product.benefits.includes(benefit)
    );

    if (matches.length === 0) return -1;
    score += matches.length * 3;
  }

  if (criteria.budget && budgetRanges[criteria.budget]) {
    const [min, max] = budgetRanges[criteria.budget];

    if (product.price < min || product.price >= max) return -1;
    score += 2;
  }

  return score;
}

function getMatchingProducts(criteria, avoidTags = []) {
  return products
    .map(product => ({
      product,
      score: scoreProduct(product, criteria, avoidTags)
    }))
    .filter(item => item.score > 0)
    .sort((a, b) => b.score - a.score);
}

