  `;
}

function renderProductGrid(container, matches, mode) {
  if (!matches.length) {
    container.innerHTML = `
      <div class="empty">
        <strong>Chưa tìm thấy sản phẩm phù hợp.</strong>
        <p>Thử điều chỉnh tiêu chí hoặc tìm kiếm bằng từ khóa khác.</p>
      </div>
    `;
    return;
  }

  container.innerHTML = `
    <div class="product-grid">
      ${matches.map(item =>
        productCardHTML(item.product || item, mode)
      ).join("")}
    </div>
  `;

  container.querySelectorAll("[data-product-action]").forEach(button => {
    button.addEventListener("click", () => {
      const product = products.find(
        item => item.id === button.dataset.productAction
      );

      if (!product) return;

      if (button.dataset.mode === "search") {
        // Đưa loại sản phẩm đã chọn vào biểu mẫu.
        document.querySelectorAll('input[name="kind"]').forEach(input => {
          input.checked = input.value === product.kind;
        });

        $("profileStatus").textContent =
          `Đã chọn ${product.name}. Hoàn thành hồ sơ để cá nhân hóa gợi ý.`;

        $("personalize").scrollIntoView({ behavior: "smooth" });
      } else {
        $("profileStatus").textContent =
          `Bạn đã quan tâm đến ${product.name}.`;
      }
    });
  });
}

